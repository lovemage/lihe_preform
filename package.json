{
  "name": "lihe-preform",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-news.mjs && node scripts/build-guides.mjs && node scripts/build-lastmod.mjs",
    "lastmod:build": "node scripts/build-lastmod.mjs",
    "lastmod:check": "node scripts/build-lastmod.mjs --check",
    "build": "next build",
    "news:build": "node scripts/build-news.mjs",
    "news:check": "node scripts/build-news.mjs --check",
    "guides:build": "node scripts/build-guides.mjs",
    "guides:check": "node scripts/build-guides.mjs --check",
    "cf:build": "opennextjs-cloudflare build",
    "next:build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/indexnow.mjs snapshot && opennextjs-cloudflare build && opennextjs-cloudflare deploy && node scripts/indexnow.mjs submit",
    "indexnow:submit": "node scripts/indexnow.mjs submit",
    "deploy:safe": "./scripts/deploy-with-secrets.sh",
    "secrets:set": "./scripts/set-cloudflare-secrets.sh",
    "secrets:list": "wrangler secret list --name lihepreform02",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "admin:seed": "node --env-file=.env --env-file=.env.local scripts/seed-admin.mjs",
    "content:migrate": "node --env-file=.env --env-file=.env.local scripts/migrate-json-to-d1.mjs",
    "media:migrate": "node --env-file=.env --env-file=.env.local scripts/migrate-public-images-to-r2.mjs",
    "content:publish": "node --env-file=.env --env-file=.env.local scripts/publish-content.mjs",
    "content:publish-and-rebuild": "node --env-file=.env --env-file=.env.local scripts/publish-and-rebuild.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.8.0",
    "@aws-sdk/client-s3": "^3.887.0",
    "jose": "^6.1.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "wrangler": "^4.38.0"
  }
}
